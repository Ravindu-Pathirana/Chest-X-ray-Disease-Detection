# Secrets / environment
.env
.env.*

# Experiment tracking
wandb/

# Model checkpoints and generated experiment artifacts
# (tracked via W&B artifacts / local disk, not Git)
*.pth
*.pt
artifacts/*
!artifacts/.gitkeep
!artifacts/DenseNet121-HPO/
artifacts/DenseNet121-HPO/*
!artifacts/DenseNet121-HPO/.gitkeep

# Exceptions: reproducibility inputs/small result summaries that
# docs/experiment_policy.md requires to be committed (the split manifest;
# T18's JSON/CSV/figure artifacts) -- unlike bulk checkpoints, which the
# *.pt / *.pth rules above still exclude even inside these directories.
!artifacts/splits/
!artifacts/T18_lung_attention/
!artifacts/densenet121_auxseg/
!artifacts/AuxSeg-Tuning
!artifacts/efficientnet_b0/
!artifacts/vit_base/
!artifacts/candidate_c_suppression/
!artifacts/T21_ablation/
!artifacts/efficiency_results.csv

!artifacts/T23_resnet50_lung_attention/
# T23: keep metrics/histories/confusion matrices/predictions/figures/module
# card, but never the ~92 MB ResNet-50 checkpoints (runs/ and runs_multiseed/)
# or any other model-weight format that exceeds GitHub's file-size limit.
artifacts/T23_resnet50_lung_attention/**/*.pt
artifacts/T23_resnet50_lung_attention/**/*.pth
artifacts/T23_resnet50_lung_attention/**/*.ckpt
artifacts/T23_resnet50_lung_attention/**/*.bin
artifacts/T23_resnet50_lung_attention/**/*.safetensors
artifacts/T23_resnet50_lung_attention/**/*.onnx
artifacts/T23_resnet50_lung_attention/**/*.h5
artifacts/T23_resnet50_lung_attention/**/*.npz


# Kaggle-generated notebook metadata and rendered output images
/artifacts/**/__huggingface_repos__.json
/artifacts/**/__results___files/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Data (never commit dataset files)
data/
!artifacts/segmentation/
